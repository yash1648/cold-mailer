# Database
MONGODB_URI="mongodb+srv://..."

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# AI (OpenRouter)
OPENROUTER_API_KEY="sk-or-v1-..."
# Optional overrides (comma-free single model id each)
AI_MODEL=""
AI_VISION_MODEL=""

# Cloudinary
CLOUD_NAME=""
CLOUD_API_KEY=""
CLOUD_API_SECRET=""

# SMTP (Gmail app password works on port 587)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="app-password"

# Optional: comma-separated list of allowed browser origins.
# Leave empty to allow any origin.
CORS_ORIGINS=""
APP_URL="https://grims-cold-mailer.vercel.app"
